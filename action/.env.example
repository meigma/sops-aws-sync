# Do not commit an action/.env file. It may contain private values.

ACTIONS_STEP_DEBUG=true

# GitHub Actions inputs preserve hyphens after the INPUT_ prefix.
INPUT_SECRET-PREFIX=/local/sops-aws-sync
INPUT_MODE=plan

# Point these at the repository checkout and a disposable runner directory.
GITHUB_REPOSITORY=meigma/sops-aws-sync
GITHUB_SHA=0123456789abcdef0123456789abcdef01234567
GITHUB_WORKSPACE=/absolute/path/to/sops-aws-sync
RUNNER_ARCH=X64
RUNNER_OS=Linux
RUNNER_TEMP=/absolute/path/to/runner-temp
